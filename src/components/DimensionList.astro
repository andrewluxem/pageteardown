---
// The eight dimension rows in rubric order: name, pips, score, source and
// note. Shared by the scorecard and the brand page.
import Pips from './Pips.astro';
import { CAPPING_DIMENSIONS, DIMENSIONS, DIMENSION_KEYS, SCORE_MAX } from '../config/rubric';
import type { Dimensions } from '../lib/schemas';

interface Props {
  dimensions: Dimensions;
  /** Leave the notes out (the brand page's summary). */
  compact?: boolean;
}
const { dimensions, compact = false } = Astro.props;
const sourceLabel = { check: 'Check', judgment: 'Judgment', both: 'Both' } as const;
---
<ul class="dim-list">
  {DIMENSION_KEYS.map((k) => {
    const d = dimensions[k];
    return (
      <li class:list={['dim', { 'dim--cap': d.score === 1 && CAPPING_DIMENSIONS.includes(k) }]}>
        <span class="dim-name">{DIMENSIONS[k]}</span>
        <Pips score={d.score} />
        <span class="dim-score num" aria-hidden="true">{d.score}/{SCORE_MAX}</span>
        <span class="dim-source mono">{sourceLabel[d.source]}</span>
        {!compact && <p class="dim-note">{d.note}</p>}
      </li>
    );
  })}
</ul>
<style>
  .dim-list { list-style: none; padding: 0; background: var(--surface); border: 1px solid var(--rule); }
  .dim {
    display: grid; grid-template-columns: auto 40px minmax(0, 1fr); grid-template-areas: 'name name name' 'pips score source' 'note note note';
    gap: 6px 12px; align-items: center; padding: 14px 16px; border-top: 1px solid var(--rule-2);
  }
  .dim:first-child { border-top: 0; }
  .dim-name { grid-area: name; font-weight: 600; }
  .dim :global(.pips) { grid-area: pips; }
  .dim-score { grid-area: score; font-size: var(--text-sm); }
  .dim-source { grid-area: source; font-size: 0.75rem; text-transform: uppercase; letter-spacing: var(--tracking); color: var(--muted); text-align: right; }
  .dim-note { grid-area: note; font-size: var(--text-sm); color: var(--ink-2); }
  .dim--cap .dim-name::after { content: ' · caps score'; font-family: var(--font-mono); font-weight: 600; font-size: 0.75rem; text-transform: uppercase; color: var(--accent); }
  @media (min-width: 520px) {
    .dim { grid-template-columns: minmax(0, 1fr) auto 36px 84px; grid-template-areas: 'name pips score source' 'note note note note'; gap: 6px 16px; }
  }
</style>
