---
import { RUBRIC_TAG, TOTAL_MAX } from '../config/rubric';
---
<section class="card" aria-labelledby="how-scores">
  <p class="eyebrow">{RUBRIC_TAG}</p>
  <h2 id="how-scores" class="display" style="font-size: 1.75rem; margin-top: 6px;">How scores work</h2>
  <p class="muted">Eight dimensions, each scored 1 to 5, for a total out of {TOTAL_MAX}. A 1 on Trust or Technical hygiene caps the page.</p>
  <a class="btn btn--ghost" href="/methodology/">Read the methodology</a>
</section>
