---
import { BANDS } from '../config/rubric';
const order = ['strong', 'solid', 'weak', 'capped'] as const;
---
<ul class="legend" aria-label="Score bands">
  {order.map((b) => (
    <li>
      <span class:list={['badge', `badge--${b}`]} aria-hidden="true">{BANDS[b].label}</span>
      <span>{BANDS[b].range}</span>
    </li>
  ))}
</ul>
