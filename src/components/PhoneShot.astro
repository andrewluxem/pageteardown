---
// A screenshot in a portrait phone frame, or an empty frame when there is
// none. Captures are 375x667 at 2x or 3x, so the frame holds the same shape.
import { FALLBACK_SIZE, screenshotSize } from '../lib/shots';

interface Props {
  screenshot: string | null;
  alt: string;
  caption: string;
}
const { screenshot, alt, caption } = Astro.props;
const size = screenshot ? await screenshotSize(screenshot) : FALLBACK_SIZE;
---
<figure class="phone">
  <div class="phone-frame" style={`aspect-ratio: ${size.width} / ${size.height}`}>
    {screenshot ? (
      <img src={screenshot} alt={alt} width={size.width} height={size.height} loading="lazy" decoding="async" />
    ) : (
      <p class="phone-empty eyebrow">No screenshot for this night</p>
    )}
  </div>
  <figcaption class="phone-cap">{caption}</figcaption>
</figure>
<style>
  .phone { max-width: 300px; margin-inline: auto; }
  .phone-frame { border: 10px solid var(--ink); border-top-width: 22px; border-bottom-width: 28px; background: var(--header-bg-2); overflow: hidden; display: grid; place-items: center; }
  .phone-frame img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .phone-empty { padding: 16px; text-align: center; }
  .phone-cap { margin-top: 10px; font-size: var(--text-sm); color: var(--ink-2); text-align: center; }
</style>
