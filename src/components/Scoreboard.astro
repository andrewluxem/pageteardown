---
// The ranked board for one night. Every row and not-captured brand is in the
// markup on every filtered page; the ones outside the filter carry `hidden`,
// so the page reads right without JS and the script can refilter in place.
import Legend from './Legend.astro';
import { BANDS, DIMENSIONS, HOMEPAGE_KINDS, HOMEPAGE_KIND_KEYS, TOTAL_MAX } from '../config/rubric';
import { VERTICAL_KEYS, verticalLabel } from '../config/verticals';
import { ALL, boardHref, missedMatches, rowMatches, type Filter } from '../lib/board-filter';
import type { FlatPage } from '../lib/boards';
import { cappingDimension, type Scored } from '../lib/scoring';
import type { NotCaptured } from '../lib/schemas';

interface Props {
  ranked: Scored<FlatPage>[];
  notCaptured: NotCaptured[];
  filter: Filter;
  /** Brand slugs that have a brand page, so a not-captured brand can link to its history. */
  brandsWithPages: Set<string>;
}
const { ranked, notCaptured, filter, brandsWithPages } = Astro.props;

const verticals = VERTICAL_KEYS.filter((k) => ranked.some((s) => s.page.vertical === k) || notCaptured.some((n) => n.vertical === k));
const kinds = HOMEPAGE_KIND_KEYS.filter((k) => ranked.some((s) => s.page.homepage_kind === k));
const groups = [
  { key: 'vertical' as const, label: 'Vertical', options: verticals.map((k) => ({ value: k, label: verticalLabel(k) })) },
  { key: 'kind' as const, label: 'Kind', options: kinds.map((k) => ({ value: k, label: HOMEPAGE_KINDS[k] })) },
];

let shown = 0;
const rows = ranked.map((s) => {
  const visible = rowMatches({ vertical: s.page.vertical, kind: s.page.homepage_kind }, filter);
  return { s, visible, rank: visible ? ++shown : undefined, cap: cappingDimension(s.page) };
});
const missed = notCaptured.map((n) => ({ n, visible: missedMatches(n.vertical, filter) }));
---
<div class="board-wrap" data-board data-vertical={filter.vertical} data-kind={filter.kind}>
  <nav class="filters" aria-label="Filter the board">
    {groups.map((g) => (
      <div class="filter-group">
        <span class="eyebrow filter-label" id={`filter-${g.key}`}>{g.label}</span>
        <div class="chips-scroll">
          <ul class="chips" aria-labelledby={`filter-${g.key}`}>
            {[{ value: ALL, label: 'All' }, ...g.options].map((o) => (
              <li>
                <a
                  class="chip"
                  href={boardHref({ ...filter, [g.key]: o.value })}
                  data-filter={g.key}
                  data-value={o.value}
                  aria-current={filter[g.key] === o.value ? 'true' : undefined}
                >{o.label}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </nav>

  <div class="board">
    <div class="board-head" aria-hidden="true">
      <span>#</span><span>Brand</span><span>Vertical</span><span>Hero headline</span><span class="head-total">Total</span><span>Band</span>
    </div>
    <ol class="board-rows" aria-label="Homepages ranked by score">
      {rows.map(({ s, visible, rank, cap }) => (
        <li class="row" data-row data-vertical={s.page.vertical} data-kind={s.page.homepage_kind} data-total={s.total} data-capped={String(s.capped)} hidden={!visible}>
          <span class="c-rank num" data-rank>{rank}</span>
          <span class="c-brand"><a class="row-link" href={`/page/${s.page.id}/`}>{s.page.brand}</a></span>
          <span class="c-vertical">{verticalLabel(s.page.vertical)}</span>
          <span class="c-headline">
            {s.page.hero_headline ? <span class="headline">{s.page.hero_headline}</span> : <span class="headline headline--image">Headline is in an image</span>}
            {cap && <span class="flag">Capped: {DIMENSIONS[cap]} scored 1</span>}
          </span>
          <span class="c-total num">{s.total}<span class="of">/{TOTAL_MAX}</span></span>
          <span class="c-band"><span class:list={['badge', `badge--${s.band}`]}>{BANDS[s.band].label}</span></span>
        </li>
      ))}
    </ol>
    <p class="board-empty" data-empty hidden={shown > 0}>No homepages match these filters.</p>
  </div>
  <Legend />

  {notCaptured.length > 0 && (
    <section class="section missed" data-missed-section hidden={!missed.some((m) => m.visible)} aria-labelledby="missed-heading">
      <h2 id="missed-heading" class="display missed-title">Not captured</h2>
      <ul class="missed-list">
        {missed.map(({ n, visible }) => (
          <li data-missed data-vertical={n.vertical} hidden={!visible}>
            <span class="missed-brand">{brandsWithPages.has(n.brand_slug) ? <a href={`/brand/${n.brand_slug}/`}>{n.brand}</a> : n.brand}</span>
            <span class="missed-vertical eyebrow">{verticalLabel(n.vertical)}</span>
            <span class="missed-reason">{n.reason}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</div>

<script>
  import { initScoreboardFilters } from '../scripts/scoreboard-filter';
  initScoreboardFilters();
</script>

<style>
  .filters { display: grid; gap: 12px; margin-bottom: 16px; }
  .filter-group { display: grid; gap: 6px; min-width: 0; }
  .chips-scroll { min-width: 0; overflow-x: auto; margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); }
  .chips-scroll .chips { flex-wrap: nowrap; width: max-content; }
  .chips a.chip { min-height: var(--touch); text-decoration: none; white-space: nowrap; }
  .chips a.chip:hover { border-color: var(--muted); }
  .chips a.chip[aria-current='true'] { background: var(--ink); color: var(--on-dark); border-color: var(--ink); }

  .board-head { display: none; }
  .board-rows { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .row {
    position: relative; display: grid; min-height: var(--touch);
    grid-template-columns: 28px minmax(0, 1fr) auto;
    grid-template-areas: 'rank brand total' 'rank vertical band' 'rank headline headline';
    gap: 2px 12px; align-items: center; padding: 12px; background: var(--surface); border: 1px solid var(--rule);
  }
  .row:hover { background: var(--ground); }
  .row:focus-within { outline: 2px solid var(--accent); outline-offset: -2px; }
  .c-rank { grid-area: rank; align-self: start; color: var(--muted); }
  .c-brand { grid-area: brand; font-weight: 600; min-width: 0; }
  .c-vertical { grid-area: vertical; font-size: var(--text-sm); color: var(--ink-2); }
  .c-headline { grid-area: headline; min-width: 0; margin-top: 4px; }
  .c-total { grid-area: total; justify-self: end; font-weight: 600; font-size: 1.125rem; }
  .c-band { grid-area: band; justify-self: end; }
  .of { font-size: 0.75em; font-weight: 500; color: var(--muted); }
  .row-link { text-decoration: none; overflow-wrap: anywhere; }
  .row-link:focus-visible { outline: none; }
  .row-link::after { content: ''; position: absolute; inset: 0; }
  .row:hover .row-link { text-decoration: underline; }
  .headline { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .headline--image { color: var(--muted); font-style: italic; }
  .flag { display: block; margin-top: 2px; font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent); }
  .c-band .badge { min-width: 76px; min-height: 28px; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .board-empty { padding: 24px 16px; color: var(--muted); background: var(--surface); border: 1px solid var(--rule); }

  .missed-title { font-size: var(--h3); line-height: 1; margin-bottom: 12px; }
  .missed-list { list-style: none; padding: 0 16px; background: var(--surface); border: 1px solid var(--rule); }
  .missed-list li { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'brand vertical' 'reason reason'; gap: 2px 12px; padding-block: 12px; border-top: 1px solid var(--rule-2); }
  .missed-list li:first-child { border-top: 0; }
  .missed-brand { grid-area: brand; font-weight: 600; }
  .missed-brand a { display: inline-block; padding-block: 12px; margin-block: -12px; }
  .missed-vertical { grid-area: vertical; align-self: center; }
  .missed-reason { grid-area: reason; color: var(--ink-2); font-size: var(--text-sm); }

  @media (min-width: 760px) {
    .filters { grid-template-columns: minmax(0, 1fr); }
    .filter-group { grid-template-columns: 72px minmax(0, 1fr); align-items: center; gap: 12px; }
    .chips-scroll { margin-inline: 0; padding-inline: 0; overflow: visible; }
    .chips-scroll .chips { flex-wrap: wrap; width: auto; }
    .board { border: 1px solid var(--rule); background: var(--surface); }
    .board-head, .row {
      grid-template-columns: 32px minmax(120px, 1.1fr) minmax(96px, 0.9fr) minmax(0, 2.6fr) 64px 92px;
      grid-template-areas: none;
      gap: 0 14px; padding: 0 16px;
    }
    .board-head {
      display: grid; align-items: center; background: var(--header-bg-2); min-height: 40px;
      font-family: var(--font-mono); font-size: var(--eyebrow); font-weight: 500; text-transform: uppercase; letter-spacing: var(--tracking); color: var(--muted);
    }
    .board-rows { gap: 0; }
    .row { min-height: 60px; padding-block: 10px; border: 0; border-top: 1px solid var(--rule-2); background: none; }
    .row > * { grid-area: auto; }
    .c-rank { align-self: center; }
    .c-headline { margin-top: 0; }
    .head-total { justify-self: end; }
    .c-band { justify-self: start; }
    .board-empty { border: 0; border-top: 1px solid var(--rule-2); }
    .missed-list li { grid-template-columns: minmax(140px, 1fr) minmax(120px, 0.8fr) minmax(0, 2fr); grid-template-areas: 'brand vertical reason'; align-items: center; }
    .missed-vertical { align-self: center; }
  }
</style>
