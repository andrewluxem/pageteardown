---
// The holding page until the first board file exists, then the board.
import Base from '../layouts/Base.astro';
import BoardView from '../components/BoardView.astro';
import HoldingPage from '../components/HoldingPage.astro';
import { TOTAL_MAX } from '../config/rubric';
import { ALL } from '../lib/board-filter';
import { getLatestNight } from '../lib/content';

const night = await getLatestNight();
---
{night ? (
  <Base description={`Every homepage captured last night, scored out of ${TOTAL_MAX} on a public rubric.`} boardPage>
    <BoardView night={night} filter={{ vertical: ALL, kind: ALL }} />
  </Base>
) : (
  <Base>
    <HoldingPage />
  </Base>
)}
