---
// Holding page until the first board ships. The board's components
// (Scoreboard, ScoreBadge, Legend, Pips, SignupCard) are kept for it.
import Base from '../layouts/Base.astro';

const points = [
  {
    title: 'A daily board',
    body: 'The homepages of a fixed panel of retail brands, captured every night and ranked by score every morning.',
  },
  {
    title: 'A public rubric',
    body: 'Eight dimensions, each scored 1 to 5, for a total out of 40. Every score comes with a written note.',
  },
  {
    title: 'The first five seconds',
    body: 'Scored on a phone, above the fold, the way a first-time visitor lands. Popups and banners count, because the visitor sees them too.',
  },
];
---
<Base>
  <section class="soon" aria-labelledby="soon-heading">
    <p class="eyebrow">Launching soon</p>
    <h1 id="soon-heading" class="display">Retail homepages, scored</h1>
    <p class="lede soon-lede">Page Teardown captures the same retail homepages every night on a phone and scores what a first-time visitor sees above the fold, on a public rubric and one daily board. The first board is on its way.</p>
  </section>

  <ul class="soon-points" aria-label="What to expect">
    {points.map((p) => (
      <li class="card">
        <h2 class="display soon-point">{p.title}</h2>
        <p class="muted">{p.body}</p>
      </li>
    ))}
  </ul>

  <p class="muted soon-sisters">Sister sites: <a href="https://www.inboxteardown.com/">Inbox Teardown</a> scores retail marketing email, and <a href="https://www.socialteardown.com/">Social Teardown</a> scores retail social posts.</p>
</Base>

<style>
  .soon { max-width: 880px; padding-block: 24px 8px; }
  .soon h1 { margin-top: 12px; font-size: clamp(2.5rem, 1.2rem + 5.5vw, 5.75rem); }
  .soon-lede { margin-top: 20px; }
  .soon-points { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-top: 48px; }
  .soon-points .card { border-top: 6px solid var(--ink); }
  .soon-point { font-size: 1.75rem; line-height: 1; }
  .soon-sisters { margin-top: 40px; }
  .soon-sisters a { display: inline-block; padding-block: 12px; margin-block: -12px; }
</style>
